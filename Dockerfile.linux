# syntax=docker/dockerfile:1.7

FROM --platform=linux/amd64 archlinux:base-devel AS dependencies

ARG BUN_VERSION=1.4.0
ARG NODE_VERSION=22.22.0

RUN pacman -Syu --noconfirm \
    && pacman -S --needed --noconfirm \
      curl \
      ffmpeg \
      file \
      gtk3 \
      libglvnd \
      mpv \
      openssl \
      rustup \
      unzip \
      xz \
      dbus \
      webkit2gtk-4.1 \
    && pacman -Scc --noconfirm

RUN mkdir -p /tmp/node-install /tmp/bun-install \
    && cd /tmp/node-install \
    && curl --fail --silent --show-error --remote-name "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    && curl --fail --silent --show-error --remote-name "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" \
    && grep " node-v${NODE_VERSION}-linux-x64.tar.xz$" SHASUMS256.txt | sha256sum --check --strict \
    && tar -xJf "node-v${NODE_VERSION}-linux-x64.tar.xz" --directory /usr/local --strip-components=1 \
    && cd /tmp/bun-install \
    && curl --fail --silent --show-error --location --remote-name "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-x64.zip" \
    && curl --fail --silent --show-error --location --remote-name "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/SHASUMS256.txt" \
    && grep " bun-linux-x64.zip$" SHASUMS256.txt | sha256sum --check --strict \
    && unzip -q bun-linux-x64.zip \
    && install -m 0755 bun-linux-x64/bun /usr/local/bin/bun \
    && rm -rf /tmp/node-install /tmp/bun-install

RUN rustup toolchain install 1.98.0 --profile minimal --component clippy,rustfmt \
    && rustup default 1.98.0 \
    && rustc -vV \
    && cargo --version \
    && bun --version \
    && node --version \
    && pkg-config --modversion gtk+-3.0 \
    && pkg-config --modversion webkit2gtk-4.1 \
    && pkg-config --modversion mpv \
    && objdump -T /usr/lib/libEGL.so.1 | grep -q 'eglGetProcAddress' \
    && objdump -T /usr/lib/libGL.so.1 | grep -q 'glXGetProcAddressARB' \
    && ffmpeg -version | head -n 1

WORKDIR /workspace

COPY package.json bun.lock bunfig.toml ./
RUN bun install --frozen-lockfile

COPY src-tauri/Cargo.toml src-tauri/Cargo.lock ./src-tauri/
RUN cargo fetch --manifest-path src-tauri/Cargo.toml --locked

COPY . .

FROM dependencies AS release
RUN bun run tauri:build:linux \
    && ldd src-tauri/target/release/media_tagger > /tmp/media-tagger-ldd.txt \
    && grep -q 'libmpv' /tmp/media-tagger-ldd.txt \
    && grep -q 'libgtk-3' /tmp/media-tagger-ldd.txt \
    && ! grep -q 'not found' /tmp/media-tagger-ldd.txt

FROM scratch AS staged-artifacts

COPY --from=release /workspace/src-tauri/target/release/media_tagger /out/media_tagger
COPY --from=release /workspace/src-tauri/icons/image_viewer_3000_512x512.png /out/image-viewer-3000.png

FROM release AS manifest
RUN set -e; { \
      printf 'platform=linux/amd64\n'; \
      uname -a; \
      rustc -vV; \
      cargo --version; \
      bun --version; \
      node --version; \
      printf 'gtk='; pkg-config --modversion gtk+-3.0; \
      printf 'webkitgtk='; pkg-config --modversion webkit2gtk-4.1; \
      printf 'mpv='; pkg-config --modversion mpv; \
      printf 'egl='; pkg-config --modversion egl; \
      printf 'gl='; pkg-config --modversion gl; \
      printf 'glx='; pkg-config --modversion glx; \
      cargo install --list; \
      ffmpeg -version | head -n 1; \
      printf '\nshared-library dependencies:\n'; \
      cat /tmp/media-tagger-ldd.txt; \
      pacman -Q; \
    } > /workspace/build-manifest.txt

FROM scratch AS artifacts
COPY --from=staged-artifacts /out /out
COPY --from=manifest /workspace/build-manifest.txt /out/build-manifest.txt
