# syntax=docker/dockerfile:1.7
FROM --platform=linux/amd64 debian:12-slim AS dependencies
ENV DEBIAN_FRONTEND=noninteractive CARGO_BUILD_JOBS=4
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl python3 unzip xz-utils build-essential pkg-config file \
    libwebkit2gtk-4.1-dev libgtk-3-dev libmpv-dev libegl-dev libgl-dev libglx-dev \
    libssl-dev librsvg2-dev patchelf ffmpeg desktop-file-utils \
    gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad \
    gstreamer1.0-libav squashfs-tools zsync \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /inputs
COPY packaging/linux/download.py packaging/linux/install-toolchains.sh packaging/linux/toolchains.json packaging/linux/appimage-tools.json packaging/linux/
RUN bash packaging/linux/install-toolchains.sh \
    && python3 packaging/linux/download.py packaging/linux/appimage-tools.json /root/.cache/tauri \
    && chmod +x /root/.cache/tauri/*
COPY package.json bun.lock bunfig.toml ./
RUN bun install --frozen-lockfile
COPY src-tauri/Cargo.toml src-tauri/Cargo.lock ./src-tauri/
RUN mkdir -p src-tauri/src && touch src-tauri/src/lib.rs \
    && cargo fetch --manifest-path src-tauri/Cargo.toml --locked
COPY . .

CMD ["bash", "packaging/linux/build-appimage.sh"]
