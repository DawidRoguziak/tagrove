{
  "schema": 1,
  "note": "Static audit batches. Globs are repo-relative (Python glob, ** recursive); tests (__tests__, *.test.*) are excluded unless a batch targets them. Roles resolve through models.json. Critical batches use finder_critical for every lens except conventions.",
  "lens_agents": {
    "rust": "review-rust",
    "frontend": "review-frontend",
    "perf": "review-performance",
    "stability": "review-stability",
    "conventions": "review-conventions",
    "tooling": "review-tooling"
  },
  "batches": [
    {
      "id": "B1",
      "title": "Scanning and indexing",
      "critical": false,
      "globs": [
        "src-tauri/src/indexer.rs",
        "src-tauri/src/services/scan_service.rs",
        "src-tauri/src/commands/scan.rs",
        "src-tauri/src/db/scan_membership.rs",
        "src-tauri/src/services/progress.rs",
        "src-tauri/src/adapter/events.rs",
        "src-tauri/src/adapter/startup_scan.rs",
        "src-tauri/src/utils/paths.rs",
        "src-tauri/src/utils/text.rs"
      ],
      "lenses": ["rust", "stability", "perf"]
    },
    {
      "id": "B2a",
      "title": "Thumbnails: rendering and database",
      "critical": false,
      "globs": [
        "src-tauri/src/services/thumb_service.rs",
        "src-tauri/src/thumbs.rs",
        "src-tauri/src/db/thumbnails.rs",
        "src-tauri/src/commands/thumbs.rs"
      ],
      "lenses": ["rust", "stability", "perf"]
    },
    {
      "id": "B2b",
      "title": "Thumbnails: serving (thumb:// scheduler and frontend image)",
      "critical": false,
      "globs": [
        "src-tauri/src/services/thumb_scheduler.rs",
        "src-tauri/src/services/thumb_protocol.rs",
        "src-tauri/src/adapter/thumb_scheme.rs",
        "src/ui/controls/ThumbnailImage.tsx",
        "src/platform/tauri/thumbnails.ts",
        "src/platform/tauri/contracts/thumbnails.ts"
      ],
      "lenses": ["rust", "frontend", "perf", "stability"]
    },
    {
      "id": "B3a",
      "title": "Database core: connections, schema, revisions, pool",
      "critical": true,
      "globs": [
        "src-tauri/src/db.rs",
        "src-tauri/src/db/connections.rs",
        "src-tauri/src/db/schema.rs",
        "src-tauri/src/db/query_revisions.rs",
        "src-tauri/src/services/db_pool.rs"
      ],
      "lenses": ["rust", "stability", "perf"]
    },
    {
      "id": "B3b",
      "title": "Query sessions, page cache, timeline sections",
      "critical": true,
      "globs": [
        "src-tauri/src/db/queries.rs",
        "src-tauri/src/db/query_sections.rs",
        "src-tauri/src/services/asset_query_service.rs",
        "src/library/query/createAssetQuery.ts",
        "src/library/createLibrary.ts"
      ],
      "lenses": ["rust", "frontend", "perf", "stability"]
    },
    {
      "id": "B4a",
      "title": "Mutations and the file-mutation journal",
      "critical": true,
      "globs": [
        "src-tauri/src/db/mutations.rs",
        "src-tauri/src/services/asset_mutation_service.rs"
      ],
      "lenses": ["rust", "stability"]
    },
    {
      "id": "B4b",
      "title": "Metadata write queue and asset commands",
      "critical": true,
      "globs": [
        "src/library/metadata/*.ts",
        "src-tauri/src/commands/assets.rs"
      ],
      "lenses": ["frontend", "rust", "stability"]
    },
    {
      "id": "B5",
      "title": "Backup, CSV, danger zone",
      "critical": true,
      "globs": [
        "src-tauri/src/services/backup_service.rs",
        "src-tauri/src/services/csv_service.rs",
        "src-tauri/src/commands/import_export.rs",
        "src/features/settings/createImportExportSettings.ts",
        "src/features/settings/createDangerZoneSettings.ts",
        "src/features/settings/ImportDbOverwriteConfirmDialog.tsx",
        "src/features/settings/ClearLibraryConfirmDialog.tsx",
        "src/features/settings/sections/ImportExportSection.tsx",
        "src/features/settings/sections/DangerZoneSection.tsx",
        "src/platform/tauri/maintenance.ts",
        "src/platform/tauri/contracts/maintenance.ts"
      ],
      "lenses": ["rust", "frontend", "stability", "conventions"]
    },
    {
      "id": "B6a",
      "title": "Video: native surface and sources",
      "critical": false,
      "globs": [
        "src-tauri/src/video/surface.rs",
        "src-tauri/src/video/mpv_events.rs",
