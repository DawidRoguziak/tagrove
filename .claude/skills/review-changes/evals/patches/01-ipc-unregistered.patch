+pub fn count_favorite_assets_service(database: &Arc<DatabaseRuntime>) -> AppResult<i64> {
+    let conn = database.admit()?.connection()?;
+    conn.query_row("SELECT COUNT(*) FROM assets WHERE is_favorite = 1", [], |row| row.get(0))
+        .map_err(Into::into)
+}
