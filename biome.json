{
  "$schema": "https://biomejs.dev/schemas/2.3.13/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "e2e/**/*.js",
      "scripts/**/*.js",
      "scripts/**/*.mjs",
      "*.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "recommended": false
      },
      "correctness": {
        "useExhaustiveDependencies": "off",
        "noUnsafeFinally": "error"
      },
      "suspicious": {
        "noConfusingVoidType": "off",
        "noControlCharactersInRegex": "off",
        "useIterableCallbackReturn": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "none"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/components/app/hooks/useAppSearchFilters.ts",
        "src/components/app/hooks/useAppShellController.ts",
        "src/components/app/hooks/useAssetTagState.ts",
        "src/components/app/hooks/useBulkSelectionController.ts",
        "src/components/app/hooks/useSelectedSummaries.ts",
        "src/components/bulk/BulkActionsSidebar.tsx",
        "src/components/lightbox/useLightboxTagging.ts",
        "src/components/search/SearchTagator.tsx",
        "src/components/search/worker/SuggestionProvider.tsx",
        "src/hooks/services/thumbnailStore.ts",
        "src/hooks/useLibraryAssets.ts",
        "src/hooks/useLibraryBrowser.ts",
        "src/hooks/useLibraryKnownTags.ts",
        "src/hooks/useLibraryLifecycle.ts",
        "src/hooks/useMediaGroupDraft.ts",
        "src/hooks/useSelectionMetadataActions.ts",
        "src/hooks/useSelectionNavigation.ts",
        "src/hooks/useSelectionState.ts",
        "src/hooks/useThumbnailQueue.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "error"
          }
        }
      }
    }
  ]
}
