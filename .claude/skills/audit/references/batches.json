      "exclude": ["src-tauri/tauri.conf.e2e.json", "src-tauri/tauri.conf.dev.json"],
      "lenses": ["tooling"]
    },
    {
      "id": "B13c",
      "title": "Scripts and build tooling",
      "critical": false,
      "globs": [
        "scripts/*",
        "package.json",
        "vite.config.ts",
        "vitest.config.ts",
        "src-tauri/tauri.conf.e2e.json",
        "src-tauri/tauri.conf.dev.json"
      ],
