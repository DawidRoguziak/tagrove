{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Image Viewer 3000",
  "version": "0.1.1",
  "identifier": "com.example.mediatagger",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Image Viewer 3000",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 720,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": ["**", "$APPDATA/thumbs/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/image_viewer_3000_32x32.png",
      "icons/image_viewer_3000_64x64.png",
      "icons/image_viewer_3000_126x128.png",
      "icons/image_viewer_3000_256x256.png",
      "icons/image_viewer_3000_512x512.png"
    ]
  }
}
