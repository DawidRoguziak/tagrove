        "src/platform/tauri/contracts/video.ts"
      ],
      "lenses": ["rust", "frontend", "stability"]
    },
    {
      "id": "B7a",
      "title": "Gallery grid, windowed scroll, timeline",
      "critical": false,
      "globs": [
        "src/features/gallery/createVirtualGrid.ts",
        "src/features/gallery/gridGeometry.ts",
        "src/features/gallery/GalleryGrid.tsx",
        "src/features/gallery/GalleryScrollbar.tsx",
