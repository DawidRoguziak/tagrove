# syntax=docker/dockerfile:1.7

FROM --platform=linux/amd64 archlinux:base-devel AS dependencies

RUN pacman -Syu --noconfirm \
    && pacman -S --needed --noconfirm \
      bun \
      curl \
      ffmpeg \
      file \
      gst-libav \
      gst-plugins-bad \
      gst-plugins-base-libs \
      gst-plugins-good \
      nodejs-lts-jod \
      openssl \
      rustup \
      dbus \
      xorg-server-xvfb \
      webkit2gtk-4.1 \
    && pacman -Scc --noconfirm

RUN rustup default stable \
    && cargo install tauri-driver --locked \
    && rustc -vV \
    && cargo --version \
    && bun --version \
    && node --version \
    && pkg-config --modversion webkit2gtk-4.1 \
    && ffmpeg -version | head -n 1

WORKDIR /workspace

COPY package.json bun.lock bunfig.toml ./
RUN bun install --frozen-lockfile

COPY src-tauri/Cargo.toml src-tauri/Cargo.lock ./src-tauri/
RUN cargo fetch --manifest-path src-tauri/Cargo.toml --locked

COPY . .

FROM dependencies AS test
RUN bun run build && bun run test && bun run test:backend

FROM test AS e2e
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 LANGUAGE=en
RUN pacman -S --needed --noconfirm webkitgtk-6.0 && pacman -Scc --noconfirm
RUN dbus-run-session -- xvfb-run --auto-servernum bun run test:e2e:tauri

FROM e2e AS release
RUN bun run tauri:build:linux \
    && ldd src-tauri/target/release/media_tagger > /tmp/media-tagger-ldd.txt \
    && ! grep -q 'not found' /tmp/media-tagger-ldd.txt

FROM scratch AS staged-artifacts

COPY --from=release /workspace/src-tauri/target/release/media_tagger /out/media_tagger

FROM release AS manifest
RUN set -e; { \
      printf 'platform=linux/amd64\n'; \
      uname -a; \
      rustc -vV; \
      cargo --version; \
      bun --version; \
      node --version; \
      cargo install --list; \
      ffmpeg -version | head -n 1; \
      printf '\nshared-library dependencies:\n'; \
      cat /tmp/media-tagger-ldd.txt; \
      pacman -Q; \
    } > /workspace/build-manifest.txt

FROM scratch AS artifacts
COPY --from=staged-artifacts /out /out
COPY --from=manifest /workspace/build-manifest.txt /out/build-manifest.txt
