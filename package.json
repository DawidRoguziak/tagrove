{
  "name": "media-tagger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=20.19 <21 || >=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "typecheck": "tsc --noEmit --project tsconfig.json --pretty false && tsc --noEmit --project tsconfig.node.json --pretty false",
    "lint": "biome lint .",
    "format:check": "biome format scripts vite.config.ts vitest.config.ts",
    "locale:check": "node scripts/validate-locales.mjs",
    "locale:generate": "node scripts/generate-locales.mjs",
    "test:locale-tools": "node --test scripts/locale-tools.test.mjs",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features --locked -- -D warnings",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets --all-features --locked",
    "audit:js": "bun audit --production --audit-level=high",
    "audit:rust": "cargo audit --file src-tauri/Cargo.lock --ignore RUSTSEC-2026-0194 --ignore RUSTSEC-2026-0195",
    "quality": "bun run locale:check && bun run test:locale-tools && bun run typecheck && bun run lint && bun run format:check && bun run rust:fmt && bun run rust:clippy && bun run audit:js && bun run audit:rust",
    "test": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run",
    "test:watch": "vitest",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "test:backend:integration": "cargo test --manifest-path src-tauri/Cargo.toml --test backend_integration --locked",
    "test:backend:e2e": "cargo test --manifest-path src-tauri/Cargo.toml --test backend_e2e --locked",
    "test:all": "bun run quality && bun run test && bun run test:backend && bun run test:e2e:tauri",
    "test:e2e:tauri": "wdio run ./e2e/wdio.conf.js",
    "tauri:dev": "tauri dev --config src-tauri/tauri.conf.dev.json",
    "tauri:build:release": "tauri build -- --locked",
    "tauri:build:linux": "tauri build --no-bundle -- --locked",
    "tauri:build:e2e": "node ./e2e/build-e2e.js",
    "build:linux:docker": "bash ./scripts/build-linux-docker.sh",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@vidstack/react": "^1.15.6",
    "fuse.js": "^7.5.0",
    "i18next": "^25.10.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.6.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.0",
    "@wdio/cli": "^9.31.2",
    "@wdio/local-runner": "^9.31.2",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "daisyui": "^5.7.20",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webdriverio": "^9.31.2"
  }
}
