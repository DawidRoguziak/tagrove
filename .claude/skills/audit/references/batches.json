    {
      "id": "B10",
      "title": "Settings operations (rest)",
      "critical": false,
      "globs": [
        "src/features/settings/**/*",
        "src/app/AppSettingsView.tsx"
      ],
      "exclude": [
        "src/features/settings/createImportExportSettings.ts",
        "src/features/settings/createDangerZoneSettings.ts",
        "src/features/settings/ImportDbOverwriteConfirmDialog.tsx",
        "src/features/settings/ClearLibraryConfirmDialog.tsx",
        "src/features/settings/sections/ImportExportSection.tsx",
        "src/features/settings/sections/DangerZoneSection.tsx"
      ],
      "lenses": ["frontend", "stability", "conventions"]
    },
    {
      "id": "B11",
      "title": "IPC surface, models, configuration",
      "critical": false,
      "globs": [
        "src-tauri/src/lib.rs",
        "src-tauri/src/models.rs",
        "src-tauri/src/error.rs",
        "src-tauri/src/main.rs",
        "src-tauri/src/commands/mod.rs",
        "src-tauri/src/commands/window.rs",
        "src/platform/tauri/assets.ts",
        "src/platform/tauri/scanning.ts",
        "src/platform/tauri/dialogs.ts",
        "src/platform/tauri/events.ts",
        "src/platform/tauri/window.ts",
        "src/platform/tauri/contracts/assets.ts",
        "src/platform/tauri/contracts/scanning.ts",
        "src-tauri/capabilities/*.json",
        "src-tauri/tauri.conf.json",
        "src-tauri/Cargo.toml",
        "src-tauri/build.rs"
      ],
      "lenses": ["rust", "frontend", "conventions"]
    },
    {
      "id": "B12",
      "title": "Bootstrap, runtime, UI kit, i18n",
      "critical": false,
      "globs": [
        "src-tauri/src/app/*.rs",
        "src/app/*",
        "src/ui/controls/*",
        "src/ui/dom/*",
        "src/ui/overlays/*",
        "src/i18n/*.ts",
        "src/i18n/*.tsx",
        "src/i18n/locales/*.json",
        "src/styles.css"
      ],
      "exclude": [
        "src/ui/controls/ThumbnailImage.tsx",
        "src/ui/dom/createVirtualList.ts",
        "src/app/AppGalleryView.tsx",
        "src/app/AppSettingsView.tsx",
        "src/app/LightboxBoundary.tsx"
      ],
      "lenses": ["frontend", "rust", "stability", "conventions"]
    },
    {
      "id": "B13a",
      "title": "E2E harness and controller",
      "critical": false,
      "globs": [
