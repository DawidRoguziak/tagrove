+#[tauri::command]
+pub async fn count_favorite_assets(state: State<'_, AppState>) -> Result<i64, String> {
+    let database = state.database.clone();
+    tauri::async_runtime::spawn_blocking(move || {
+        let conn = database.admit()?.connection()?;
+        conn.query_row("SELECT COUNT(*) FROM assets WHERE is_favorite = 1", [], |row| row.get(0))
+            .map_err(Into::into)
+    })
+    .await
+    .map_err(|e| format!("favorite count worker failed: {e}"))?
+    .map_err(|e: crate::error::AppError| e.to_string())
+}
