{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tagrove",
  "version": "0.1.1",
  "identifier": "com.example.mediatagger",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tagrove",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 720,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": ["**", "$APPDATA/thumbs/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Photography",
    "shortDescription": "Browse and tag images, videos and GIFs",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ]
  }
}
